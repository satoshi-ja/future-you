# OpenAI API Key (required - or use mock mode)
OPENAI_API_KEY=your_openai_api_key_here

# Server port (default: 5173)
PORT=5173

# OpenAI Models (optional - available: gpt-5, gpt-5-pro, gpt-5-pro-2025-10-06)
GPT_MODEL=gpt-5-pro
SORA_MODEL=sora-2

# Mock Mode (set to 'true' to test without API calls)
USE_MOCK=false

# MongoDB Connection (default: mongodb://localhost:27017/future-you)
MONGODB_URI=mongodb://localhost:27017/future-you

# ChatKit Configuration (Optional - for Agent Builder integration)
# Get your workflow ID from https://platform.openai.com/agent-builder
CHATKIT_WORKFLOW_ID=
CHATKIT_ENABLED=false
